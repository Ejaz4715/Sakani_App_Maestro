# Sakani Maestro-Mobile - runtime variable reference (Services: core + service suites; Main E2E)
#
# Maestro does NOT read this file. Every value is passed per run:
#   maestro test -e NAME=value <flow>                      (direct)
#   npm test -- --env NAME=value [...]                       (runner; forwarded to maestro as -e)
# Every flow declares its own non-sensitive default in its `env:` block, so nothing here is required
# for a default run. Copy to `.env` for personal notes only - `.env` is git-ignored.
#
# NEVER commit real National IDs, OTPs, card data, tokens or passwords. Values below are blanks or
# non-sensitive placeholders.

# --- Target --------------------------------------------------------------------------------------
# App under test (hard-coded as appId in every flow): fi.iwa.sakani
# Device: the runner picks the first ready `adb devices` entry; override with --device <serial>.

# --- Authentication (shared: subflows/login.yaml) -------------------------------------------------
# Account a flow signs in as. Main-app flows default it in their own env: block; login.yaml itself
# has no default. Service flows do not sign in themselves: the runner signs in first with
# subflows/services-session.yaml (default 1000011487); for a direct `maestro test` run that helper first.
NATIONAL_ID=
# e2e/appeal-request.yaml - an existing PRE user whose persisted Eligibility is NOT ELIGIBLE.
NOT_ELIGIBLE_NATIONAL_ID=
# e2e/check-eligibility.yaml - OTP for the newly registered user (PRE environment).
REGISTRATION_OTP=

# --- Main app E2E (.maestro/e2e/ - changes business data, double-flag guarded) --------------------
PROJECT=
PROJECT_SEARCH=
MODULE=
APPEAL_TEXT=Automation test appeal - PRE environment
# full-journey-paid.yaml - payment gateway TEST card only. Never a real card.
PAYMENT_CARD_SCHEME=
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_EXPIRY=
PAYMENT_CARD_CVV=
PAYMENT_CARD_HOLDER=

# --- Shared helper inputs (set by callers, not by users) -----------------------------------------
# ANCHOR (clear-overlays.yaml), TARGET / DESTINATION (tap-until-destination.yaml),
# MIN_AGE_HIJRI_YEARS (registration), EXPECTED / VALUE / ABOVE / BELOW (suite-local helpers).

# --- Service: mortgage-calculator (SAKANI-32007) --------------------------------------------------
# Per-case defaults live in each flow. NOTE: INCOME and DOWN_PAYMENT are also used by
# financial-advisor with a DIFFERENT meaning (DOWN_PAYMENT is a percentage here, an amount there),
# so pass them per service run, never for a mixed consolidated run.
PRICE=
INCOME=
OBLIGATIONS=
YEARS=
RATE=
DOWN_PAYMENT=
BENEFICIARY=yes
FIRST_HOME=yes

# --- Service: financial-advisor (SAKANI-23300) ----------------------------------------------------
PRODUCT_TYPE=Market Ready Unit
EMPLOYMENT=Civil - Government Sector
SALARY_BANK=Bank Albilad
HOUSING_ALLOWANCE=
OTHER_ALLOWANCES=
COMMITMENTS=
COMMITMENT_MONTHS=
SAVINGS=
FIRST_PRODUCT=
SECOND_PRODUCT=

# --- Service: sakani-offers (SAKANI-31966) --------------------------------------------------------
OFFER_NAME=Test Company name EN
COMPANY_NAME=Maestro QA Vendor
BUSINESS_ACTIVITY=Home Services
CONTACT_MOBILE=0555555555

# --- Service: cancel-ready-made (SAKANI-51392) + Core "cancel ready made project" -----------------
# Prepared booking (reserved): 1119880062 / Target Segment test 22 / Apartment 190-113 / 03-01-0030-190-113
READY_MADE_PROJECT=
READY_MADE_PROJECT_SEARCH=
READY_MADE_UNIT=
READY_MADE_BLOCK=
READY_MADE_APARTMENT=
READY_MADE_BUILDING=
READY_MADE_FLOOR=
BOOKING_UNIT_CODE=
BOOKING_DATE=
CANCEL_REASON=Reject by bank
# Backend attestation of the Active MOH Financial Application (never inferred in the app)
MOH_FA_CONFIRMED=false
MOH_FA_EVIDENCE=
# Explicit per-run approval of the single Confirm cancellation tap (TC-004 only)
CANCEL_FINAL_APPROVED=false

# --- Services: real-estate-tax (SAKANI-23459), neighborhood-greetings (SAKANI-38946) -------------
# No runtime variables. Both depend on account state (see their READMEs).
